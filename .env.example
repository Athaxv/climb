# Neon Postgres (source of truth)
# Use the pooled host (-pooler) for the app. Prisma needs pgbouncer=true on that URL.
# Keep DIRECT_URL on the unpooled host for migrations.
# On serverless, add &connection_limit=5. Local Next runs layout + page in parallel, so omit
# connection_limit or set it to 10+ or the pool will time out.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=10"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Redis — cache and rate limiting only. App still works if this is unset or Redis is down.
REDIS_URL="redis://localhost:6379"

# Dodo Payments — server only. Never expose these to the browser.
# Replace the placeholders. Values that still contain "..." are ignored.
# Get a test key from https://test.dodopayments.com (Developer → API Keys).
# Create a $1 one-time product (100 cents, tax_category: digital_products) and paste its pdt_ id.
DODO_PAYMENTS_API_KEY="dodo_test_..."
# Signing secret from Developer → Webhooks. Values that contain "..." are ignored; rank will not move.
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
DODO_PAYMENTS_ENVIRONMENT="test_mode"
# Optional. Local checkout prefers the browser origin (whatever port Next used).
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/api/checkout/complete?username={username}"
DODO_BID_PRODUCT_ID="pdt_..."

# Signs the post-payment session cookie. Not used as a login wall.
AUTH_SECRET="generate-a-long-random-string"

# Groq — server only. Classifies a pasted profile URL into category + skills.
# Create a key at https://console.groq.com/keys. If unset, Climb falls back to
# GitHub → Engineering, X → Creators, otherwise Other.
GROQ_API_KEY="gsk_..."

# Optional. Raises GitHub API rate limits for profile inference.
GITHUB_TOKEN=""

# Public origin for return URLs and share links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
